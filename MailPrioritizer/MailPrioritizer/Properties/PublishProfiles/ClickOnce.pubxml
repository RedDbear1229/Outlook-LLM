<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce Publish Profile for MailPrioritizer
  Usage (VS IDE): Right-click project > Publish > select this profile
  Usage (MSBuild CLI):
    msbuild MailPrioritizer.csproj /t:Publish /p:PublishProfile=ClickOnce
      /p:BuildingInsideVisualStudio=true /p:Configuration=Release
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Output folder for publish artifacts (setup.exe, .vsto, .application) -->
    <PublishUrl>publish\</PublishUrl>
    <!-- Install from: FileSystem = local/network share; Web = HTTP URL -->
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <!-- Set to a UNC path or HTTP URL for network deployment, e.g.:
         <InstallUrl>\\server\share\MailPrioritizer\</InstallUrl>
         <InstallUrl>http://internal/MailPrioritizer/</InstallUrl>
    -->
    <InstallUrl></InstallUrl>
    <!-- Update check settings -->
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <!-- Version auto-increment -->
    <AutoIncrementApplicationRevision>true</AutoIncrementApplicationRevision>
    <PublishWizardCompleted>true</PublishWizardCompleted>
    <!-- Code signing: set to true and supply a cert if distributing externally -->
    <SignManifests>false</SignManifests>
    <!-- Bootstrap prerequisites into installer -->
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <PublisherName>MailPrioritizer</PublisherName>
    <ProductName>MailPrioritizer</ProductName>
  </PropertyGroup>
</Project>
